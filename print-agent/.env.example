# ============================================================
# HuskyPDV — Configuração do Agente de Impressão
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# URL pública do backend (não alterar)
SUPABASE_URL=https://rydfhkphvhkqxwpqoeku.supabase.co

# Chave de serviço (obter no painel Super Admin > Cloud > Settings > API)
# IMPORTANTE: nunca compartilhar esta chave fora do notebook do cliente.
SUPABASE_SERVICE_ROLE_KEY=

# UUID do tenant (estabelecimento). Obter no painel Super Admin >
# Estabelecimentos > copiar ID do estabelecimento.
TENANT_ID=

# Estação que esta instância vai imprimir (deve bater com "Setor"
# da impressora cadastrada no PDV). Ex.: Caixa, Cozinha, Bar.
STATION=Caixa

# Dispositivo da impressora térmica
# Linux:   /dev/usb/lp0   ou   /dev/usb/lp1
# Windows: nome compartilhado da impressora (ex.: POS-80)
PRINTER_DEVICE=/dev/usb/lp0

# Largura da bobina (em colunas)
# 80mm => 48   |   58mm => 32
WIDTH=48

# Frequência de polling em milissegundos
POLL_INTERVAL_MS=2000
